# Copia este archivo a .env y completa las contrasenas antes de iniciar Compose.
# .env es local: no se incluye en Git ni en la imagen Docker.
# Si ya existen volumenes, usa el nombre de proyecto y las credenciales originales.
COMPOSE_PROJECT_NAME=herramientasd
POSTGRES_DB=Proyecto_HDesarrollo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
APP_PORT=8080
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050
